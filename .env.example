# URL base de la aplicación bajo prueba
BASE_URL=https://app-dev.drtwrk.io

# Ejecutar en modo headless (true/false)
HEADLESS=false

# Canal de navegador que usará Playwright: "chrome", "chrome-beta", "msedge", etc.
# Deja vacío o usa "chromium" para el Chromium empaquetado por Playwright.
BROWSER_CHANNEL=chrome

# Rutas relativas al root del proyecto para subir/descargar archivos en los tests
UPLOADS_DIR=data/uploads
DOWNLOADS_DIR=data/downloads

# Credenciales por defecto (alternativa simple a config/users.json)
DEFAULT_USERNAME=user@example.com
DEFAULT_PASSWORD=CHANGE_ME
